<Window x:Class="Yukkuri.MiniWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="油库里 · 悬浮窗" Width="410" Height="330" ResizeMode="NoResize"
        WindowStyle="ToolWindow" Topmost="True" ShowInTaskbar="False" Background="White">
  <Grid Margin="16,13" PreviewKeyDown="Editor_KeyDown">
    <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="*"/><RowDefinition Height="34"/><RowDefinition Height="43"/><RowDefinition Height="23"/></Grid.RowDefinitions>
    <Grid>
      <TextBlock Text="油库里语音" FontWeight="SemiBold" Foreground="#B73548"/>
      <TextBlock Text="{Binding ClipDuration}" HorizontalAlignment="Right" FontSize="11" Foreground="#747B83"/>
    </Grid>
    <TextBox x:Name="FloatingEditor" Grid.Row="1" Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
             FontSize="13" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="240"
             VerticalContentAlignment="Top" HorizontalContentAlignment="Left"
             VerticalScrollBarVisibility="Auto" Margin="0,1,0,8" Padding="7,5" IsReadOnly="{Binding Sending}"
             AutomationProperties.Name="悬浮窗语音文字"/>
    <TextBlock Grid.Row="2" Text="{Binding CurrentConversation}" Foreground="#747B83" FontSize="11"
               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding CurrentConversation}"/>
    <StackPanel Grid.Row="3" Orientation="Horizontal">
      <Button Click="Preview_Click" Style="{StaticResource IconButton}" Content="&#xE768;" ToolTip="试听" AutomationProperties.Name="试听" IsEnabled="{Binding CanGenerate}"/>
      <Button Click="Stop_Click" Style="{StaticResource IconButton}" Content="&#xE71A;" ToolTip="停止" AutomationProperties.Name="停止" Margin="6,0,8,0"/>
      <Button Click="Send_Click" Content="一键发送 QQ 语音" Background="#197E76" BorderBrush="#197E76" Foreground="White" IsEnabled="{Binding CanSend}" Padding="12,8"/>
      <Button Click="Main_Click" Style="{StaticResource IconButton}" Content="&#xE8A7;" ToolTip="打开工作台" AutomationProperties.Name="打开工作台" Margin="7,0,0,0"/>
    </StackPanel>
    <TextBlock Grid.Row="4" Text="{Binding Status}" FontSize="11" Foreground="#747B83" VerticalAlignment="Bottom" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
  </Grid>
</Window>
