<Window x:Class="Yukkuri.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Yukkuri"
        Title="油库里语音 · Yukkuri Voice" Width="1200" Height="820" Icon="Assets/app.ico"
        MinWidth="1000" MinHeight="700" WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_KeyDown">
  <Window.Resources>
    <CollectionViewSource x:Key="GroupedVoices" Source="{Binding ClassicVoices}">
      <CollectionViewSource.GroupDescriptions>
        <PropertyGroupDescription PropertyName="GroupName"/>
      </CollectionViewSource.GroupDescriptions>
    </CollectionViewSource>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="186"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#252A2F">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="126"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="23,30,15,0">
          <StackPanel Orientation="Horizontal">
            <Border Background="#B73548" Width="31" Height="31" CornerRadius="6">
              <TextBlock Text="ゆ" Foreground="White" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="YUKKURI" Foreground="White" FontWeight="Bold" FontSize="16" Margin="9,3,0,0"/>
          </StackPanel>
          <TextBlock Text="油库里语音" Foreground="#B7BDC5" Margin="2,12,0,0" FontSize="12"/>
        </StackPanel>
        <StackPanel Grid.Row="1">
          <RadioButton x:Name="ComposeNav" GroupName="Nav" Style="{StaticResource NavItem}" Checked="Navigate" Tag="compose">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE8D4;" FontFamily="Segoe Fluent Icons" Margin="0,0,12,0"/>
              <TextBlock Text="语音工作台"/>
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="HistoryNav" GroupName="Nav" Style="{StaticResource NavItem}" Checked="Navigate" Tag="history">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE81C;" FontFamily="Segoe Fluent Icons" Margin="0,0,12,0"/>
              <TextBlock Text="生成记录"/>
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="SettingsNav" GroupName="Nav" Style="{StaticResource NavItem}" Checked="Navigate" Tag="settings">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" Margin="0,0,12,0"/>
              <TextBlock Text="QQ 与引擎"/>
            </StackPanel>
          </RadioButton>
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="22,0,16,23">
          <Border Height="1" Background="#3A4046" Margin="0,0,0,17"/>
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="6" Height="6" Fill="#7AC9B3" VerticalAlignment="Center" Margin="0,0,7,0"/>
            <TextBlock Text="本地合成" Foreground="#DBE1E5" FontSize="11"/>
          </StackPanel>
          <TextBlock Text="Windows  /  v1.2.1" Foreground="#7E8891" FontSize="10" Margin="0,9,0,0"/>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1">
      <Grid.RowDefinitions><RowDefinition Height="86"/><RowDefinition Height="*"/><RowDefinition Height="58"/></Grid.RowDefinitions>
      <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Background="White">
        <Grid Margin="30,0">
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="YUKKURI VOICE" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,0,0,5"/>
            <TextBlock x:Name="PageTitle" Text="语音工作台" FontSize="23" FontWeight="SemiBold"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Border Background="#E9F4F0" CornerRadius="4" Padding="10,7" Margin="0,0,12,0" MaxWidth="250">
              <StackPanel Orientation="Horizontal">
                <Ellipse Width="6" Height="6" Fill="#197E76" VerticalAlignment="Center" Margin="0,0,7,0"/>
                <TextBlock Text="{Binding QQStatus}" Foreground="#197E76" FontSize="11" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </Border>
            <Button Style="{StaticResource IconButton}" Content="&#xE8A7;" ToolTip="悬浮窗" AutomationProperties.Name="悬浮窗" Click="ToggleMini"/>
          </StackPanel>
        </Grid>
      </Border>
      <ScrollViewer x:Name="ComposePage" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" IsEnabled="{Binding CanEdit}">
        <StackPanel Margin="30,14,26,16">
          <Grid Margin="0,0,0,12">
            <TextBlock Text="选择音色" Style="{StaticResource SectionTitle}" Margin="0"/>
            <ComboBox ItemsSource="{Binding Source={StaticResource GroupedVoices}}" SelectedItem="{Binding ClassicVoice}"
                      DisplayMemberPath="Name" Width="330" HorizontalAlignment="Right"
                      MaxDropDownHeight="500" AutomationProperties.Name="选择音色">
              <ComboBox.GroupStyle>
                <GroupStyle>
                  <GroupStyle.HeaderTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="8,10,0,6" FontSize="12"/>
                    </DataTemplate>
                  </GroupStyle.HeaderTemplate>
                </GroupStyle>
              </ComboBox.GroupStyle>
              <ComboBox.ItemContainerStyle>
                <Style TargetType="ComboBoxItem">
                  <Setter Property="Padding" Value="18,6,8,6"/>
                  <Setter Property="ToolTip" Value="{Binding Availability}"/>
                </Style>
              </ComboBox.ItemContainerStyle>
            </ComboBox>
          </Grid>
          <TextBlock Text="{Binding EngineNote}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,12"/>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="235"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,23,0">
              <Grid Margin="0,0,0,10">
                <TextBlock Text="要说的话" Style="{StaticResource SectionTitle}" Margin="0"/>
                <CheckBox Content="自动生成" IsChecked="{Binding AutoGenerate}" HorizontalAlignment="Right" FontSize="11"/>
              </Grid>
              <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6">
                <Grid>
                  <Grid.RowDefinitions><RowDefinition Height="130"/><RowDefinition Height="30"/></Grid.RowDefinitions>
                  <TextBox x:Name="DraftEditor" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap"
                           AcceptsReturn="True" MaxLength="240" FontSize="16" BorderThickness="0" Padding="16,15" IsReadOnly="{Binding Sending}"
                           VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" Background="Transparent"
                           AutomationProperties.Name="要说的话"/>
                  <Grid Grid.Row="1" Margin="13,0,12,7">
                    <Button Content="&#xE74D;" FontFamily="Segoe Fluent Icons" ToolTip="清空文字" AutomationProperties.Name="清空文字"
                            Click="ClearText" Width="25" MinHeight="25" Height="25" Padding="0" BorderThickness="0" HorizontalAlignment="Left"/>
                    <TextBlock Text="{Binding CharacterCount}" Foreground="{StaticResource Muted}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                  </Grid>
                </Grid>
              </Border>
              <Grid Margin="0,13,0,0">
                <StackPanel Orientation="Horizontal">
                  <Button Click="Generate_Click" Style="{StaticResource PrimaryButton}" IsEnabled="{Binding CanGenerate}" AutomationProperties.Name="生成语音">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="&#xE945;" FontFamily="Segoe Fluent Icons" Margin="0,2,7,0"/>
                      <TextBlock Text="生成语音"/>
                    </StackPanel>
                  </Button>
                  <Button Click="Example_Click" Content="示例" Margin="8,0,0,0" Padding="12,8" FontSize="12"/>
                </StackPanel>
                <TextBlock Text="Ctrl + Enter" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#8A929A" FontSize="10"/>
              </Grid>
            </StackPanel>
            <Border Grid.Column="1" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0" Padding="21,0,0,0">
              <StackPanel>
                <TextBlock Text="语速" Style="{StaticResource SectionTitle}"/>
                <Grid Margin="0,2,0,0">
                  <TextBlock Text="语速" FontSize="12"/>
                  <TextBlock Text="{Binding Speed, StringFormat={}{0:0.00}×}" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" FontSize="11"/>
                </Grid>
                <Slider Minimum="0.65" Maximum="1.6" Value="{Binding Speed}" Margin="-5,5,-3,10" AutomationProperties.Name="语速"/>
              </StackPanel>
            </Border>
          </Grid>
          <Border Height="1" Background="{StaticResource Line}" Margin="0,18,0,16"/>
          <Grid Margin="0,0,0,11">
            <TextBlock Text="语音预览" Style="{StaticResource SectionTitle}" Margin="0"/>
            <TextBlock Text="{Binding ClipDuration}" HorizontalAlignment="Right" FontSize="12" Foreground="{StaticResource Muted}"/>
          </Grid>
          <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Background="White" Padding="15,12">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="46"/></Grid.ColumnDefinitions>
              <Button Click="Preview_Click" Style="{StaticResource IconButton}" Content="&#xE768;" IsEnabled="{Binding HasClip}" ToolTip="试听" AutomationProperties.Name="试听"/>
              <StackPanel Grid.Column="1" Margin="5,0,14,0">
                <TextBlock Text="{Binding ClipTitle}" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/>
                <local:WaveformView x:Name="Waveform" Height="28"/>
              </StackPanel>
              <Button Grid.Column="2" Click="Stop_Click" Style="{StaticResource IconButton}" Content="&#xE71A;" ToolTip="停止" AutomationProperties.Name="停止"/>
            </Grid>
          </Border>
          <Grid Margin="0,15,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
              <Button Click="Send_Click" Background="#197E76" BorderBrush="#197E76" Foreground="White" IsEnabled="{Binding CanSend}" AutomationProperties.Name="一键发送 QQ 语音">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE720;" FontFamily="Segoe Fluent Icons" Margin="0,2,8,0"/><TextBlock Text="一键发送 QQ 语音"/></StackPanel>
              </Button>
              <Button Click="Export_Click" Margin="9,0,0,0" IsEnabled="{Binding HasClip}" ToolTip="导出 WAV 文件">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74E;" FontFamily="Segoe Fluent Icons" Margin="0,2,7,0"/><TextBlock Text="导出"/></StackPanel>
              </Button>
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding CurrentConversation}" Foreground="{StaticResource Muted}"
                       Margin="18,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding CurrentConversation}" AutomationProperties.Name="当前 QQ 会话"/>
          </Grid>
        </StackPanel>
      </ScrollViewer>
      <Grid x:Name="HistoryPage" Grid.Row="1" Visibility="Collapsed" Margin="30,25,26,20">
        <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid>
          <TextBlock Text="最近 60 条" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Click="OpenAudioFolder" Style="{StaticResource IconButton}" Content="&#xE8B7;" ToolTip="打开音频文件夹" AutomationProperties.Name="打开音频文件夹"/>
            <Button Click="DeleteHistory_Click" Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="删除选中记录" AutomationProperties.Name="删除选中记录" Margin="8,0,0,0"/>
          </StackPanel>
        </Grid>
        <Grid Grid.Row="1">
          <ListView x:Name="HistoryList" ItemsSource="{Binding History}" BorderThickness="0" Background="Transparent"
                    MouseDoubleClick="History_DoubleClick" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    HorizontalContentAlignment="Stretch">
            <ListView.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="4,15">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="110"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,14,0">
                      <TextBlock Text="{Binding Summary}" FontSize="14" MaxHeight="44" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding VoiceName}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding DurationLabel}" VerticalAlignment="Center" FontSize="12"/>
                    <TextBlock Grid.Column="2" Text="{Binding TimeLabel}" VerticalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="11"/>
                    <Button Grid.Column="3" Click="HistoryPlay_Click" Style="{StaticResource IconButton}" Content="&#xE768;" ToolTip="使用并试听" AutomationProperties.Name="使用并试听"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
          <TextBlock x:Name="HistoryEmpty" Text="还没有生成记录" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
        </Grid>
      </Grid>
      <ScrollViewer x:Name="SettingsPage" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30,25,30,30">
          <TextBlock Text="QQ 输入联动" Style="{StaticResource SectionTitle}"/>
          <Grid Margin="0,4,0,18">
            <StackPanel>
              <CheckBox Content="读取 QQ 当前聊天输入框" IsChecked="{Binding ListenToQQ}"/>
              <TextBlock Text="仅处理当前正在编辑的草稿，所有合成在本机完成。" FontSize="11" Foreground="{StaticResource Muted}" Margin="22,8,0,0"/>
            </StackPanel>
            <TextBlock Text="{Binding CaptureShortcutHint}" HorizontalAlignment="Right" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
          </Grid>
          <Border Height="1" Background="{StaticResource Line}" Margin="0,0,0,22"/>
          <TextBlock Text="QQ 本地连接" Style="{StaticResource SectionTitle}"/>
          <TextBlock Text="{Binding CurrentConversation}" FontSize="13" TextTrimming="CharacterEllipsis"/>
          <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <Button Click="RefreshQQBridge_Click">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons" Margin="0,2,7,0"/>
                <TextBlock Text="重新连接 QQ"/>
              </StackPanel>
            </Button>
            <Button Content="桥接配置" Click="OpenBridgeGuide" Margin="9,0,0,0"/>
          </StackPanel>
          <TextBlock Text="{Binding QQBridgeStatus}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,12,0,0"/>
          <TextBlock Text="{Binding SendShortcutHint}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/>
          <Border Height="1" Background="{StaticResource Line}" Margin="0,23,0,22"/>
          <Grid Margin="0,0,0,13">
            <TextBlock Text="本机试听" Style="{StaticResource SectionTitle}" Margin="0"/>
            <Button Style="{StaticResource IconButton}" Content="&#xE72C;" HorizontalAlignment="Right" Click="RefreshDevices_Click" ToolTip="刷新设备" AutomationProperties.Name="刷新设备"/>
          </Grid>
          <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding PreviewDevice}" DisplayMemberPath="Name" AutomationProperties.Name="本机试听设备"/>
          <Border Height="1" Background="{StaticResource Line}" Margin="0,23,0,22"/>
          <TextBlock Text="油库里声库" Style="{StaticResource SectionTitle}"/>
          <TextBlock Text="{Binding AquesPath}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,12"/>
          <StackPanel Orientation="Horizontal">
            <Button Content="导入授权声库" Click="ImportEngine_Click"/>
            <Button Content="查看引擎授权" Click="OpenAquesSite" Margin="9,0,0,0"/>
          </StackPanel>
          <TextBlock Text="支持 AquesTalk 1、2、10。标有「评估版」的音色受 SDK 发音限制；完整授权说明见使用说明。" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,12,0,0"/>
          <Border Height="1" Background="{StaticResource Line}" Margin="0,23,0,22"/>
          <CheckBox Content="保存新生成的语音记录（本机）" IsChecked="{Binding KeepHistory}"/>
          <StackPanel Orientation="Horizontal" Margin="0,17,0,0">
            <Button Content="使用说明" Click="OpenGuide" FontSize="12"/>
            <Button Content="数据文件夹" Click="OpenDataFolder" Margin="9,0,0,0" FontSize="12"/>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
      <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
        <Grid Margin="30,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
            <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="#197E76" Margin="0,0,8,0" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding Status}" FontSize="12"/>
          </StackPanel>
          <TextBlock Grid.Column="1" Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource Muted}"
                     VerticalAlignment="Center" MaxHeight="36" TextTrimming="CharacterEllipsis"/>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
